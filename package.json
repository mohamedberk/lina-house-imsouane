{
  "name": "lina-house",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@payloadcms/db-mongodb": "3.68.5",
    "@payloadcms/next": "3.68.5",
    "@payloadcms/plugin-seo": "^3.68.5",
    "@payloadcms/plugin-stripe": "^3.68.5",
    "@payloadcms/richtext-lexical": "3.68.5",
    "@payloadcms/storage-uploadthing": "^3.68.5",
    "@payloadcms/translations": "^3.68.5",
    "@payloadcms/ui": "3.68.5",
    "@paypal/react-paypal-js": "^8.9.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@react-google-maps/api": "^2.20.8",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.0",
    "@types/react-datepicker": "^7.0.0",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "convex": "^1.23.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "16.4.7",
    "embla-carousel-auto-scroll": "^8.5.2",
    "embla-carousel-autoplay": "^8.5.2",
    "embla-carousel-class-names": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^11.12.0",
    "graphql": "^16.8.1",
    "groq-sdk": "^1.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "next": "15.4.10",
    "next-themes": "^0.4.3",
    "payload": "3.68.5",
    "react": "19.2.1",
    "react-datepicker": "^9.0.0",
    "react-day-picker": "^9.4.1",
    "react-dom": "19.2.1",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^9.14.1",
    "react-phone-number-input": "^3.4.14",
    "resend": "^6.6.0",
    "sharp": "0.34.2",
    "sonner": "^2.0.3",
    "stripe": "^20.1.0",
    "swiper": "^11.1.15",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "yet-another-react-lightbox": "^3.29.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@fal-ai/client": "^1.10.1",
    "@paypal/paypal-js": "^9.1.0",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.5.4",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.7",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "postcss": "^8.4.32",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.1",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "browserslist": [
    "Chrome >= 100",
    "Firefox >= 100",
    "Safari >= 15",
    "Edge >= 100",
    "not dead",
    "not IE 11"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
